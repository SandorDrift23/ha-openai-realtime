# Copy to .env and fill in. .env is gitignored — never commit keys.
# Local slim voice (Windows + Voice PE). No Home Assistant tools in step 1.

OPENAI_API_KEY=
SLIM_VOICE=true

VOICE_PROVIDER=gpt_live
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8080

# Slim conversation — leave these as-is for step 1
ENABLE_WEB_SEARCH=false
ENABLE_ECHO_PROBE=false
ENABLE_RECORDING=false
ENABLE_DISCONNECT_TOOL=false
FOLLOW_UP_LISTEN_SECONDS=0
PLAYBACK_PREBUFFER_MS=80
WAKE_OPEN_DELAY_MS=500
FOLLOW_UP_OPEN_DELAY_MS=500
PHASE_IDLE_DEBOUNCE_MS=3000

# Spoken language / voice
OPENAI_VOICE=marin
TRANSCRIPTION_LANGUAGE=de
INSTRUCTIONS=You are a friendly voice assistant. Have a natural spoken conversation. Keep answers short. Do not control a smart home and do not look things up online.

# Leave unset for slim local (no Assist / MCP):
# LONGLIVED_TOKEN=
# HA_MCP_URL=
